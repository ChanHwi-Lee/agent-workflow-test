{
  "name": "@tooldi/agent-persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/interview": {
      "types": "./dist/schema/interview.d.ts",
      "import": "./dist/schema/interview.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "src/sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "drizzle:generate": "drizzle-kit generate",
    "test": "node --test dist/object-store/objectStoreClient.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tooldi/agent-contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10"
  }
}
