# 로컬 공통 런타임 설정이다.
# packages/config/src/env.ts 의 loadSharedEnv/loadAgentApiEnv/loadAgentWorkerEnv 가 읽는다.
NODE_ENV=test
LOG_LEVEL=info

# API/worker가 공유하는 agent runtime PostgreSQL DSN이다.
# API persistence, worker runtime persistence, LangGraph PostgresSaver 기본 연결에 사용한다.
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:55432/tooldi_agent_runtime_test

# Redis/BullMQ transport 설정이다.
# API queue publish와 worker queue consume 경로에서 사용한다.
REDIS_URL=redis://localhost:6379/9
BULLMQ_QUEUE_NAME=agent-workflow-toolditor-local

# 로컬 object store 설정이다.
# run request snapshot, v6 artifacts, debug HTML preview 저장에 사용한다.
OBJECT_STORE_MODE=filesystem
OBJECT_STORE_ROOT_DIR=/tmp/tooldi-agent-runtime-toolditor-local
OBJECT_STORE_BUCKET=tooldi-agent-runtime-toolditor-local
OBJECT_STORE_PREFIX=agent-runtime-toolditor-local

# 로컬 API 서버와 worker callback 경로 설정이다.
# scripts/local-toolditor-env.sh, apps/agent-api, apps/agent-worker가 공유한다.
AGENT_WORKFLOW_HOST=127.0.0.1
AGENT_WORKFLOW_PORT=3100
AGENT_WORKFLOW_BASE_URL=http://127.0.0.1:3100
API_HOST=127.0.0.1
API_PORT=3100
PUBLIC_BASE_URL=http://127.0.0.1:3100
AGENT_INTERNAL_BASE_URL=http://127.0.0.1:3100

# worker 실행 설정이다.
# worker.ts bootstrap, heartbeat, lease, local queue mode에서 사용한다.
WORKER_QUEUE_TRANSPORT_MODE=bullmq
WORKER_CONCURRENCY=1
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_LEASE_TTL_MS=30000

# LangGraph checkpointer는 PostgresSaver만 사용한다.
# packages/agent-graph/src/checkpointer.ts 와 worker interrupt/resume 테스트에서 사용한다.
LANGGRAPH_CHECKPOINTER_MODE=postgres
LANGGRAPH_CHECKPOINTER_SCHEMA=agent_langgraph
POSTGRES_APPLICATION_NAME=agent-worker-toolditor-local

# scripts/ensure-local-langgraph-postgres.sh 가 로컬 Postgres 컨테이너를 만들 때 사용한다.
# interrupt/resume smoke와 worker 테스트 기본값도 이 값과 맞춰져 있다.
AGENT_RUNTIME_POSTGRES_CONTAINER_NAME=tooldi-agent-runtime-postgres
AGENT_RUNTIME_POSTGRES_PORT=55432
AGENT_RUNTIME_POSTGRES_DB=tooldi_agent_runtime_test
AGENT_RUNTIME_POSTGRES_USER=postgres
AGENT_RUNTIME_POSTGRES_PASSWORD=postgres
AGENT_RUNTIME_POSTGRES_IMAGE=postgres:16-alpine

# Gemini 기반 LLM 호출에 사용한다.
# interviewLlm, v6HtmlGen, v6TrendResearch, 선택형 vision rerank 경로가 참조한다.
GOOGLE_API_KEY=replace-with-google-api-key

# HTML 생성 프로바이더 설정이다.
# apps/agent-worker/src/phases/v6HtmlGen.ts 와 관련 worker env에서 사용한다.
HTML_GEN_PROVIDER=gemini
HTML_GEN_THINKING_LEVEL=low
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_EFFORT=low
CLAUDE_CODE_TIMEOUT_MS=180000

# 선택형 웹 트렌드 리서치 노드 설정이다.
# 사용자가 trendResearch 옵션을 켠 경우 v6 HTML 생성 전 시각 트렌드 컨텍스트를 만든다.
TREND_RESEARCH_MODE=enabled
TREND_RESEARCH_MODEL=gemini-3-flash-preview
TREND_CACHE_TTL_SECONDS=604800

# 실제 Tooldi 콘텐츠 API를 통해 카탈로그/소스 후보를 가져오는 로컬 연동 설정이다.
# v6 asset resolver와 catalog source integration에서 사용한다.
TOOLDI_CATALOG_SOURCE_MODE=tooldi_api_direct
TOOLDI_CONTENT_API_BASE_URL=http://localhost

# v6 placeholder 이미지를 실제 Tooldi asset으로 치환하는 RAG 설정이다.
# apps/agent-worker/src/phases/v6AssetResolver.ts 에서 사용한다.
V6_ASSET_RAG_MODE=enabled
V6_ASSET_EMBEDDING_ENDPOINT=http://127.0.0.1:7070/embed/text
V6_ASSET_QDRANT_URL=http://127.0.0.1:6333
V6_ASSET_PHOTO_COLLECTION=tooldi_photos_v1
V6_ASSET_GRAPHIC_COLLECTION=tooldi_graphics_v1
V6_ASSET_PUBLIC_BASE_URL=https://dev-file.tooldi.com
V6_ASSET_TOP_K=40
V6_ASSET_RERANK_CANDIDATE_COUNT=6
V6_ASSET_TIMEOUT_MS=8000
V6_ASSET_VISION_RERANK_MODE=enabled
V6_ASSET_VISION_MODEL=gemini-3.1-flash-lite-preview
# RAG 단계에서 적절한 에셋 후보가 없을때 이미지를 생성하는 과정에 대한 설정이다.
# V6_ASSET_GENERATION_MODE: off | enabled
V6_ASSET_GENERATION_MODE=off
V6_ASSET_GENERATION_MODEL=gemini-3.1-flash-image-preview
V6_ASSET_GENERATION_TIMEOUT_MS=30000

# AGW generated asset publish 설정이다.
# V6_ASSET_GENERATION_MODE=enabled 시 Gemini 생성 이미지를 사용자 파일 보관함(AI 콘텐츠)에 저장하는 경로에서 사용한다.
#
# AGENT_WORKER_INTERNAL_TOKEN
#   - worker → agent-api 내부 인증 토큰이다.
#   - agent-api와 agent-worker가 동일한 값을 가져야 한다.
#   - local-toolditor-env.sh의 기본값(local-dev-worker-token)이 적용되므로 로컬 개발 시 생략 가능하다.
#   - 운영 환경에서는 반드시 무작위 고강도 토큰으로 교체한다.
AGENT_WORKER_INTERNAL_TOKEN=local-dev-worker-token

# TOOLDI_PHP_API_BASE_URL
#   - agent-api → PHP API 호출 기본 URL이다 (trailing slash 없음).
#   - V6_ASSET_GENERATION_MODE=enabled 시에만 실제로 호출된다.
#   - 로컬 PHP 개발 서버가 8080 포트가 아니라면 실제 주소로 교체한다.
TOOLDI_PHP_API_BASE_URL=http://127.0.0.1:8080

# TOOLDI_PHP_INTERNAL_TOKEN
#   - agent-api가 PHP API를 호출할 때 X-Tooldi-Internal-Token 헤더에 담는 토큰이다.
#   - PHP 서버의 TOOLDI_PHP_INTERNAL_TOKEN 환경변수와 반드시 일치해야 한다.
#   - 운영 환경에서는 반드시 무작위 고강도 토큰으로 교체한다.
TOOLDI_PHP_INTERNAL_TOKEN=local-dev-php-token


# LangSmith tracing 설정이다.
# LangChain SDK가 process.env에서 직접 읽으며 LLM 호출 추적과 디버깅에 사용한다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_PROJECT=tooldi-agent-workflow
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

